<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleDevelopmentRegion</key>
	<string>$(DEVELOPMENT_LANGUAGE)</string>
	<key>CFBundleDisplayName</key>
	<string>RoomBridge</string>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleName</key>
	<string>$(PRODUCT_NAME)</string>
	<key>CFBundlePackageType</key>
	<string>$(PRODUCT_BUNDLE_PACKAGE_TYPE)</string>
	<key>CFBundleShortVersionString</key>
	<string>$(MARKETING_VERSION)</string>
	<key>CFBundleVersion</key>
	<string>$(CURRENT_PROJECT_VERSION)</string>
	<key>LSRequiresIPhoneOS</key>
	<true/>
	<key>NSAppTransportSecurity</key>
	<dict>
		<!-- The app only talks to the server address the user types (their own Mac), over plain
		     http/ws. NSAllowsLocalNetworking alone does not cover IPv6 hotspot addresses, and its
		     presence would make iOS ignore NSAllowsArbitraryLoads, so only this key is set. -->
		<key>NSAllowsArbitraryLoads</key>
		<true/>
	</dict>
	<key>NSCameraUsageDescription</key>
	<string>RoomBridge uses the camera for augmented reality: it shows proposed design objects in your room and, only while you choose to broadcast, shares that view with people you invited.</string>
	<key>NSMicrophoneUsageDescription</key>
	<string>RoomBridge records a short voice note only while you hold the talk button, so the expert and observers in your room can hear your question.</string>
	<key>NSSpeechRecognitionUsageDescription</key>
	<string>RoomBridge turns your voice notes into text on this iPhone so everyone in the room can also read them. Audio is not sent to Apple for this.</string>
	<key>NSLocalNetworkUsageDescription</key>
	<string>RoomBridge connects to a room server on your local network (for example, a Mac running the RoomBridge server) so an expert and your family can join.</string>
	<key>UIApplicationSceneManifest</key>
	<dict>
		<key>UIApplicationSupportsMultipleScenes</key>
		<false/>
	</dict>
	<key>UILaunchScreen</key>
	<dict/>
	<key>UIRequiredDeviceCapabilities</key>
	<array>
		<string>arm64</string>
	</array>
	<key>UIStatusBarHidden</key>
	<false/>
	<key>UISupportedInterfaceOrientations</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>
</dict>
</plist>

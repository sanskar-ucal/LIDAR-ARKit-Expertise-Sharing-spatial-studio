# Copy to server/.env (never commit .env). All values are optional.

# Listen on all interfaces so an iPhone on the same Wi-Fi can reach the Mac.
HOST=0.0.0.0
PORT=8787

# Base URL put into viewer/expert links. Leave empty to derive it from the
# request's Host header (works when the phone uses http://<mac-ip>:8787).
# Remote deployments behind a TLS proxy: https://roombridge.example.org
PUBLIC_URL=

# Serve the built web viewer (web/dist) from this server. Set to 0 when the
# Vite dev server serves the viewer instead.
SERVE_WEB=1

# Room lifetime
ROOM_IDLE_TTL_MS=1800000
ROOM_MAX_TTL_MS=43200000

# Set to 1 only when running behind a trusted reverse proxy, to use
# X-Forwarded-For for rate limiting.
TRUST_PROXY=0

LOG_LEVEL=info

    "zod": "4.6.5"
  },
  "devDependencies": {
    "@types/node": "20.19.43",
    "@types/ws": "8.18.2",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "vitest": "4.1.11"
  }
}
